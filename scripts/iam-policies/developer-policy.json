{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyAccess",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:ListFunctions",
        "lambda:ListVersionsByFunction",
        "lambda:GetPolicy",
        "apigateway:GET",
        "logs:DescribeLogGroups",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "cloudwatch:DescribeAlarms",
        "xray:GetTraceGraph",
        "xray:GetTraceSummaries",
        "xray:BatchGetTraces"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:userid": "nice-cks-graphrag-*"
        }
      }
    },
    {
      "Sid": "DevelopmentDeployment",
      "Effect": "Allow",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PublishVersion",
        "lambda:CreateAlias",
        "lambda:UpdateAlias"
      ],
      "Resource": [
        "arn:aws:lambda:eu-west-2:*:function:nice-cks-graphrag-dev-*",
        "arn:aws:lambda:eu-west-2:*:function:nice-cks-graphrag-staging-*"
      ]
    },
    {
      "Sid": "DenyProductionChanges",
      "Effect": "Deny",
      "Action": [
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "apigateway:DELETE",
        "apigateway:PATCH",
        "apigateway:POST",
        "apigateway:PUT"
      ],
      "Resource": [
        "arn:aws:lambda:eu-west-2:*:function:nice-cks-graphrag-production-*",
        "arn:aws:apigateway:eu-west-2::/restapis/*/stages/production"
      ]
    }
  ]
}